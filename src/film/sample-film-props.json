   }
  ],
  "scenes": [
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "barbarika"
    ],
    "narration": "Three arrows. That's all one warrior needed to end the greatest war in history.",
    "visual": "Extreme close-up of three arrows with glowing golden tips in a dark leather quiver on a warrior's back, the warrior standing still on a misty ridge",
    "camera": "slow push-in on the arrow tips, then rack focus to the misty battlefield far below",
    "sound": "low wind, a deep ominous drum beat"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [],
    "narration": "Kurukshetra. Two vast armies, waiting for the war that would decide everything.",
    "visual": "Vast aerial view of two enormous ancient armies facing each other across a dusty plain at dawn, chariots, elephants and banners, dust rising",
    "camera": "high aerial drone shot gliding forward between the armies",
    "sound": "conch shells in the distance, wind, horses"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "barbarika"
    ],
    "narration": "And walking towards it was Barbarika, grandson of Bhima, carrying Shiva's boon: arrows that never miss.",
    "visual": "Barbarika walks alone along a dusty forest path towards the distant battlefield, bow in hand, sunbeams through trees",
    "camera": "wide tracking shot from the side, slowly moving with him",
    "sound": "footsteps on dry leaves, birds, soft wind"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "barbarika",
     "brahmin"
    ],
    "narration": "Under a peepal tree, an old Brahmin stopped him and laughed. Three arrows, for an entire war?",
    "visual": "Under a giant peepal tree, the old Brahmin, seen from behind, blocks the path with his staff; Barbarika stops and looks at him",
    "camera": "over-the-shoulder shot from behind the Brahmin towards Barbarika",
    "sound": "rustling leaves, a soft chuckle-like breeze, birds"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "barbarika"
    ],
    "narration": "Barbarika released one arrow. It flew through the tree and marked every single leaf.",
    "visual": "Barbarika draws his bow and releases one golden arrow; it streaks through the branches of the giant peepal tree, and every leaf begins to glow with a tiny golden mark",
    "camera": "low angle, slow motion as the arrow leaves the bow, then tilt up into the glowing tree",
    "sound": "bowstring twang, whoosh, a shimmering magical chime"
   },
   {
    "type": "shot",
    "seconds": 6,
    "characters": [
     "brahmin"
    ],
    "narration": "Then it circled the Brahmin's foot. He had hidden one leaf beneath it.",
    "visual": "Close-up at ground level: a glowing golden arrow hovers and circles a bare foot pressed on a single green peepal leaf, saffron robe hem visible",
    "camera": "ground-level macro shot, the arrow circling slowly",
    "sound": "a soft humming whoosh, leaves rustling"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "barbarika"
    ],
    "narration": "",
    "dialogue": "I made a vow. I always fight for the weaker side.",
    "visual": "Night. Barbarika sits by a small campfire, firelight on his face, looking up proudly as he speaks",
    "camera": "medium close-up, slow push-in",
    "sound": "crackling fire, crickets"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "brahmin"
    ],
    "narration": "That was the problem. Whichever side he joined would become stronger, so he'd have to switch forever.",
    "visual": "The Brahmin's silhouette stands on a hill against a red sunset, looking down at the two armies; the light shifts back and forth between the two sides",
    "camera": "slow orbit around the silhouette",
    "sound": "deep low tension drone, distant wind"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [
     "barbarika"
    ],
    "narration": "So the Brahmin, Krishna in disguise, asked for one gift: his head. Barbarika agreed.",
    "visual": "Barbarika kneels with his head bowed and hands joined in golden divine light, a single peacock feather slowly floating down in front of him",
    "camera": "slow crane down from above to eye level",
    "sound": "a single temple bell, soft choir hum"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [],
    "narration": "From a hilltop, he watched all eighteen days. Asked who won, he said: only Krishna's chakra.",
    "visual": "From a high hilltop marked with a marigold-garlanded stone, the view over a vast smoky battlefield at dusk with fallen banners; a spinning golden disc of light glows in the clouds above",
    "camera": "slow pull-back from the marigold stone to reveal the battlefield",
    "sound": "distant battle echoes fading into silence"
   },
   {
    "type": "shot",
    "seconds": 8,
    "characters": [],
    "narration": "Today, millions worship him as Khatu Shyam in Rajasthan. Follow for more untold stories.",
    "visual": "A beautiful temple in Rajasthan at night, glowing with hundreds of oil lamps and marigold garlands, devotees seen from behind holding diyas",
    "camera": "slow forward glide towards the glowing temple entrance",
    "sound": "temple bells, soft devotional music, crowd murmur"
   }
  ]
